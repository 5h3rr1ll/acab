#!/usr/bin/env bash
#
# ACAB - All Configs Are Beautiful
# A CLI tool to switch between AWS config files and profiles using fzf

set -euo pipefail

# Configuration
AWS_DIR="${AWS_CONFIG_DIR:-$HOME/.aws}"
readonly AWS_DIR

# Colors for output
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m' # No Color

# Helper functions
error() {
    echo -e "${RED}Error: $*${NC}" >&2
    exit 1
}

success() {
    echo -e "${GREEN}$*${NC}" >&2
}

warn() {
    echo -e "${YELLOW}$*${NC}" >&2
}

# Check if fzf is installed
check_fzf() {
    if ! command -v fzf &> /dev/null; then
        error "fzf is not installed. Please install it first: https://github.com/junegunn/fzf"
    fi
}

# List all config files in AWS directory
list_config_files() {
    local configs
    configs=$(find "$AWS_DIR" -maxdepth 1 -type f -name "config*" 2>/dev/null | sort)

    if [[ -z "$configs" ]]; then
        error "No AWS config files found in $AWS_DIR"
    fi

    echo "$configs"
}

# Select config file using fzf
select_config_file() {
    local config_file

    config_file=$(list_config_files | fzf \
        --prompt="AWS config file > " \
        --height=40% \
        --border \
        --header="Select an AWS config file" \
        --preview 'echo "--- Preview of {} ---" && sed -n "1,50p" {}' \
        --preview-window=right:60%)

    [[ -z "$config_file" ]] && error "No config file selected"

    echo "$config_file"
}

# Extract profiles from a config file
extract_profiles() {
    local config_file="$1"

    if [[ ! -f "$config_file" ]]; then
        error "Config file not found: $config_file"
    fi

    # Extract profile names from [profile name] and [default]
    # AWS config format: [profile name] or [default]
    local profiles
    profiles=$(grep -E '^\[' "$config_file" | \
        sed -E 's/^\[(profile )?([^]]+)\]/\2/' | \
        sort -u)

    if [[ -z "$profiles" ]]; then
        error "No profiles found in $config_file"
    fi

    echo "$profiles"
}

# Extract SSO account ID for a specific profile from config file
extract_account_id() {
    local config_file="$1"
    local profile_name="$2"

    # Use awk to match the exact section header, then extract sso_account_id
    awk -v profile="$profile_name" '
        /^\[default\]/ && profile == "default" { in_section=1; next }
        /^\[profile / {
            # Extract profile name from [profile name]
            line = $0
            sub(/^\[profile /, "", line)
            sub(/\]$/, "", line)
            if (line == profile) {
                in_section=1
                next
            }
        }
        in_section && /^\[/ { exit }
        in_section && /^sso_account_id[[:space:]]*=/ {
            sub(/^sso_account_id[[:space:]]*=[[:space:]]*/, "")
            print
            exit
        }
    ' "$config_file"
}

# Build composite entries combining profile names with account IDs
extract_profiles_with_accounts() {
    local config_file="$1"
    local profiles

    # Get base profile names
    profiles=$(extract_profiles "$config_file")

    # Build composite entries
    while IFS= read -r profile; do
        local account_id
        account_id=$(extract_account_id "$config_file" "$profile")

        if [[ -n "$account_id" ]]; then
            echo "$profile ($account_id)"
        else
            echo "$profile"
        fi
    done <<< "$profiles"
}

# Select profile using fzf
select_profile() {
    local config_file="$1"
    local selection profile

    # Use composite entries for unified search
    selection=$(extract_profiles_with_accounts "$config_file" | fzf \
        --prompt="AWS profile > " \
        --height=40% \
        --border \
        --header="Select an AWS profile from $(basename "$config_file") - Search by name or account ID" \
        --preview "echo 'Profile: {}' && echo && grep -A 10 '^\[.*{}\]' '$config_file' || grep -A 10 '^\[profile {}\]' '$config_file'")

    [[ -z "$selection" ]] && error "No profile selected"

    # Extract profile name from "profile-name (account-id)" or "profile-name"
    profile=$(echo "$selection" | sed -E 's/[[:space:]]*\([^)]+\)[[:space:]]*$//')

    echo "$profile"
}

# Validate and find config file by name
find_config_file() {
    local config_name="$1"
    local config_path

    # If it's already a full path
    if [[ -f "$config_name" ]]; then
        echo "$config_name"
        return 0
    fi

    # Try as basename
    config_path="$AWS_DIR/$config_name"
    if [[ -f "$config_path" ]]; then
        echo "$config_path"
        return 0
    fi

    # Try with 'config' prefix if not already present
    if [[ ! "$config_name" =~ ^config ]]; then
        config_path="$AWS_DIR/config-$config_name"
        if [[ -f "$config_path" ]]; then
            echo "$config_path"
            return 0
        fi
    fi

    # Use fzf to fuzzy find
    local found
    found=$(list_config_files | fzf \
        --filter="$config_name" \
        --select-1 \
        --exit-0)

    if [[ -n "$found" ]]; then
        echo "$found"
        return 0
    fi

    error "Config file not found: $config_name"
}

# Validate profile exists in config file
validate_profile() {
    local config_file="$1"
    local profile_input="$2"

    # First: exact profile name match (fast path)
    if extract_profiles "$config_file" | grep -qxF "$profile_input"; then
        echo "$profile_input"
        return 0
    fi

    # Second: if input is numeric, search by account ID
    if [[ "$profile_input" =~ ^[0-9]+$ ]]; then
        local matches

        # Search account IDs efficiently using awk
        warn "Searching for account IDs containing '$profile_input'..."
        matches=$(awk -v search="$profile_input" '
            /^\[default\]/ { current_profile="default"; next }
            /^\[profile / {
                line = $0
                sub(/^\[profile /, "", line)
                sub(/\]$/, "", line)
                current_profile = line
                next
            }
            /^sso_account_id[[:space:]]*=/ {
                sub(/^sso_account_id[[:space:]]*=[[:space:]]*/, "")
                if (index($0, search) > 0) {
                    print current_profile
                }
            }
        ' "$config_file")

        if [[ -n "$matches" ]]; then
            local match_count
            match_count=$(echo "$matches" | wc -l | tr -d ' ')

            if [[ "$match_count" -eq 1 ]]; then
                echo "$matches"
                return 0
            else
                # Multiple matches - let user select
                warn "Found $match_count profiles matching '$profile_input'"
                local selected
                selected=$(echo "$matches" | fzf \
                    --prompt="Select profile > " \
                    --height=40% \
                    --border \
                    --header="Select from $match_count matching profiles")

                if [[ -n "$selected" ]]; then
                    echo "$selected"
                    return 0
                fi
            fi
        fi
    fi

    # Third: fuzzy search on profile names
    warn "Profile '$profile_input' not found in $(basename "$config_file")"
    local found
    found=$(extract_profiles "$config_file" | fzf \
        --filter="$profile_input" \
        --select-1 \
        --exit-0)

    if [[ -n "$found" ]]; then
        echo "$found"
        return 0
    fi

    error "Profile not found: $profile_input"
}

# Set AWS config and profile
set_aws_config() {
    local config_file="$1"
    local profile="$2"

    # Send informational output to stderr (so it displays but doesn't get eval'd)
    success "✓ AWS configuration updated:"
    echo "  AWS_CONFIG_FILE=$config_file" >&2
    echo "  AWS_PROFILE=$profile" >&2
    echo "" >&2
    echo "  Double-check with:" >&2
    echo '  echo "AWS_CONFIG_FILE=$AWS_CONFIG_FILE"; echo "AWS_PROFILE=$AWS_PROFILE"' >&2
    echo "" >&2

    # Output only the export commands to stdout (for eval)
    echo "export AWS_CONFIG_FILE='$config_file'"
    echo "export AWS_PROFILE='$profile'"
}

# Show usage
usage() {
    cat << EOF
ACAB - All Configs Are Beautiful

Usage:
    acab                        # Interactive mode: select config and profile
    acab <config>               # Select config, then choose profile
    acab <config> <profile>     # Set config and profile directly

Examples:
    acab                        # Select both interactively
    acab config-personal        # Choose config-personal, then select profile
    acab config work-profile    # Set config and work-profile directly
    acab config 444455556666    # Select profile by account ID (if multiple roles)

Environment Variables:
    AWS_CONFIG_DIR              # Directory containing AWS configs (default: ~/.aws)

Requirements:
    - fzf (https://github.com/junegunn/fzf)

EOF
    exit 0
}

# Main function
main() {
    # Check for help flag
    if [[ "${1:-}" == "-h" ]] || [[ "${1:-}" == "--help" ]]; then
        usage
    fi

    # Check dependencies
    check_fzf

    local config_file profile

    case $# in
        0)
            # Interactive mode: select both
            config_file=$(select_config_file)
            profile=$(select_profile "$config_file")
            ;;
        1)
            # Select config, then profile interactively
            config_file=$(find_config_file "$1")
            profile=$(select_profile "$config_file")
            ;;
        2)
            # Direct mode: both provided
            config_file=$(find_config_file "$1")
            # Extract profile name from composite entry if needed
            local profile_input
            profile_input=$(echo "$2" | sed -E 's/[[:space:]]*\([^)]+\)[[:space:]]*$//')
            # Validate and potentially fuzzy-find profile
            profile=$(validate_profile "$config_file" "$profile_input")
            [[ -z "$profile" ]] && profile="$profile_input"
            ;;
        *)
            error "Too many arguments. Use 'acab --help' for usage."
            ;;
    esac

    set_aws_config "$config_file" "$profile"
}

main "$@"
